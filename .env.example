# Lakshya Mock & Marks Tracker Environment Configuration
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env

# Web Server Port (Default: 8856)
PORT=8856

# Host binding (Default: 0.0.0.0)
HOST=0.0.0.0

# Data persistence directory (Default: /app/data inside container or ./data locally)
# DATA_DIR=/app/data

# Optional Integration: Self-Hosted Kanboard Task & Syllabus Sync
# Uncomment and fill if you use Kanboard for tracking exam preparation milestones
# KANBOARD_URL=http://192.168.1.50:1337/jsonrpc.php
# KANBOARD_USER=ai
# KANBOARD_TOKEN=your_kanboard_api_token_here
# KANBOARD_PROJECT_ID=4
